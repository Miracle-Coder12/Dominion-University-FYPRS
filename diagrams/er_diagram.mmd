    %% Reading Progress (Requested CENTER/LEFT relative to Annotations)
    USERS ||--o{ USER_READING_PROGRESS : "records"
    PROJECTS ||--o{ USER_READING_PROGRESS : "monitors"
    PROJECTS ||--o{ PROJECT_VERSIONS : "versions"

    %% Base Entities (Requested BOTTOM/LEFT)
    USERS ||--o{ PROJECTS : "authors"
